NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster0.xxxxx.mongodb.net/fileforge_db?retryWrites=true&w=majority

# JWT secrets — use strong random strings in production
JWT_SECRET=change-me-to-a-long-random-secret-256-bits
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret

# Python conversion service URL
PYTHON_API_URL=http://localhost:8000

# Frontend URL (for CORS and Stripe redirects)
CLIENT_URL=http://localhost:5173

# Razorpay (India payments)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe (International payments)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXX
STRIPE_PRICE_ID=price_XXXXXXXXXXXX
