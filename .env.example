# ─────────────────────────────────────────────
#  FileForge — Root Environment Variables
#  Copy this to .env and fill in your values
#  NEVER commit .env to git
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
NODE_ENV=production
CLIENT_URL=https://yourdomain.com
VITE_API_URL=https://yourdomain.com

# ── MongoDB ───────────────────────────────────
# For docker-compose (local MongoDB container):
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=change_me_strong_password

# For MongoDB Atlas (cloud — use this in production):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/fileforge_db

# ── JWT Secrets — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex_string

# ── Razorpay (India payments) ─────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Stripe (International payments) ──────────
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXX
STRIPE_PRICE_ID=price_XXXXXXXXXXXX
